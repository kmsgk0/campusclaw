# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Set before first start. Existing users keep their stored password hashes.
SEED_PASSWORD=
# Generate independently with the same command. Keep this value server-side.
JWT_SECRET=
HOST_PORT=8080
BIND_ADDRESS=127.0.0.1

# OpenAI-compatible services, configured only on the server.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
